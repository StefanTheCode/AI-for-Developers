<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core with the SQLite provider: a real relational database in a single
         file, zero server to install. Perfect for learning EF Core. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <!-- Explicitly pin the native SQLite bundle to a patched version. EF Core 10
         pulls in an older transitive build that NuGet flags for a known CVE;
         referencing the newer bundle directly overrides it. Security > silence. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

</Project>
