<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.4.1" />
    <PackageReference Include="OllamaSharp" Version="5.4.25" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sample code under review is DATA, not part of this app's build.
         Exclude it from compilation but copy it next to the app so tools can read it. -->
    <Compile Remove="sample\**\*.cs" />
    <None Include="sample\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
