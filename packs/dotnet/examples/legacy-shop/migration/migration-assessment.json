  "risks": [
    {
      "title": "Pricing and cart quirks change silently (order total ignores coupon/VAT, ViewState price, 3-for-2 per line, rounding)",
      "impact": "high",
      "mitigation": "Parity tests on the cart and checkout flow + characterization tests on PriceCalculator before any change. Decide quirk by quirk: keep or fix on purpose."
    },
    {
      "title": "Sign-in breaks while two apps run (Forms auth ticket + machineKey)",
      "impact": "high",
      "mitigation": "Remote authentication through the System.Web adapters until the login page moves; then switch to ASP.NET Core cookie auth in one release."
    },
    {
      "title": "Session cart lost between old and new pages",
      "impact": "medium",
      "mitigation": "Remote session (System.Web adapters) while both apps run; move cart pages together; serialize CartLine as JSON."
    },
    {
      "title": "API clients depend on 302 redirects from [Authorize] endpoints",
      "impact": "medium",
      "mitigation": "Check API consumers. .NET 10 returns 401 - document it as a breaking change or keep the redirect on purpose."
    },
    {
      "title": "Deleting a product deletes its order history (EF6 cascade)",
      "impact": "medium",
      "mitigation": "Decide Restrict vs Cascade in the EF Core model; add a soft delete if history must stay."
    },
    {
      "title": "Product images use System.Drawing (Windows-only on .NET 6+)",
      "impact": "low",
      "mitigation": "Stay on Windows hosting at first, or move to ImageSharp/SkiaSharp (check the licenses)."
    }
  ],
