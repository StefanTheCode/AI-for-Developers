<?xml version="1.0" encoding="utf-8"?>
<!-- TRAP T16: web.config transforms. ASP.NET Core uses appsettings.{Environment}.json + environment variables instead. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="ShopContext" connectionString="Data Source=prod-sql01;Initial Catalog=LegacyShop;User ID=shop_app;Password=CHANGE_ME_FAKE" xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
  </connectionStrings>
  <appSettings>
    <add key="Inventory.Url" value="http://inventory.internal/InventoryService.svc" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <customErrors mode="On" xdt:Transform="SetAttributes(mode)" />
  </system.web>
  <system.serviceModel>
    <client>
      <endpoint name="InventoryEndpoint" address="http://inventory.internal/InventoryService.svc" xdt:Transform="SetAttributes(address)" xdt:Locator="Match(name)" />
    </client>
  </system.serviceModel>
</configuration>
